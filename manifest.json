{
  "manifest_version": 3,
  "name": "Browser Forensic Recorder & Time-Travel Debugger",
  "version": "2.0.0",
  "description": "Production-grade browser forensic recorder, DOM time-travel debugger, lifecycle tracer, and Agent MCP interface.",
  "permissions": [
    "activeTab",
    "storage",
    "scripting",
    "tabs",
    "webNavigation"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "dist/extension/service-worker.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["dist/extension/content-script.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "action": {
    "default_popup": "dist/src/extension/popup/popup.html",
    "default_title": "Forensic Recorder Controls"
  },
  "devtools_page": "dist/src/extension/devtools/devtools.html",
  "web_accessible_resources": [
    {
      "resources": [
        "dist/extension/page-script.js",
        "dist/src/ui/*",
        "dist/assets/*"
      ],
      "matches": ["<all_urls>"]
    }
  ]
}
